# ==============================================================
# Laksana POS - Template Konfigurasi Environment Produksi
# Salin file ini menjadi .env di server Anda: cp .env.production.example .env
# ==============================================================

# Mode Debug (Wajib false di server publik untuk keamanan)
API_DEBUG=false

# Konfigurasi Database (Gunakan PostgreSQL ATAU MySQL)
# Opsi 1: PostgreSQL / Supabase (Connection String)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Opsi 2: MySQL / MariaDB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pos_cashier
DB_USER=pos_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_YANG_KUAT

# Keamanan JWT (Gunakan string acak minimal 32 karakter)
JWT_SECRET=GANTI_DENGAN_STRING_RANDOM_PANJANG_DAN_RAHASIA_MINIMAL_32_KARAKTER
JWT_EXPIRY=28800

# Kunci Domain CORS (Hanya izinkan domain aplikasi frontend Anda)
CORS_ORIGIN=https://pos.domainanda.com

# Token Rahasia untuk Migrasi Database via Web (Opsional)
MIGRATION_SECRET=GANTI_DENGAN_SECRET_MIGRASI_RAHASIA
